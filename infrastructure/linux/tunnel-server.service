# systemd-юнит сервера VoidLink (tunnel-server).
# Установка: infrastructure/linux/install-server.sh (или вручную в
# /etc/systemd/system/, затем systemctl daemon-reload && systemctl enable --now tunnel-server).
# Адрес и доп. флаги — в /etc/default/tunnel-server. Полный список — `tunnel-server
# --help`: --workers, лимиты (--relay-*/--ctrl-*/--hello-*/--plain-*/--join-*),
# --metrics <addr>, --lease-ttl-days, --tcp/--no-tcp, --federate/--peer/--fed-pool.
# Неизвестный флаг сервер отвергает («неизвестный флаг») и не стартует; первый
# позиционный аргумент — адрес прослушивания. С -q в журнале не будет Server code.
#   TUNNEL_LISTEN=0.0.0.0:5555
#   TUNNEL_ARGS=--workers 4
[Unit]
Description=VoidLink tunnel server (UDP relay/rendezvous)
Documentation=file:///opt/tunnel/SERVER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnel
Group=tunnel
Environment=TUNNEL_LISTEN=0.0.0.0:5555
Environment=TUNNEL_ARGS=
EnvironmentFile=-/etc/default/tunnel-server
# server.json лежит в /var/lib/tunnel (StateDirectory, владелец tunnel, 0700)
StateDirectory=tunnel
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tunnel
ExecStart=/opt/tunnel/tunnel-server ${TUNNEL_LISTEN} --data /var/lib/tunnel $TUNNEL_ARGS

Restart=on-failure
RestartSec=2s
# SIGTERM/SIGINT: обработчик есть — crates/server/src/signals.rs, ставится в
# main.rs:141 до старта воркеров. По сигналу воркеры, TCP и метрики
# останавливаются, делается финальный save_now, код выхода 0 (main.rs:149).
# TimeoutStopSec ниже — с запасом на финальное сохранение.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=15s
LimitNOFILE=65536

# --- Ужесточение ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
# Порт < 1024 потребует AmbientCapabilities=CAP_NET_BIND_SERVICE
# и CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
